NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Social login (Supabase Auth OAuth). Only the lowercase literal `true` enables a provider button.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=
NEXT_PUBLIC_AUTH_APPLE_ENABLED=
NEXT_PUBLIC_AUTH_FACEBOOK_ENABLED=
APP_URL=http://localhost:3000
# Production only: allow search indexing when VERCEL_ENV=production and this flag is the lowercase literal `true` (default off).
SITE_INDEXING_ENABLED=
# Live deposits are deliberately unavailable. Never put privileged keys in NEXT_PUBLIC_*.
RESEND_API_KEY=
EMAIL_FROM=
# staging_outbox — store rendered emails in app.notification_previews (no Resend). On staging (licitatiero-staging.vercel.app) EMAIL_DELIVERY_MODE=staging_outbox is REQUIRED: Vercel deploys staging as VERCEL_ENV=production, so without this flag mail falls back to Resend or unavailable.
EMAIL_DELIVERY_MODE=
# Staging only: write sign-up confirmation links to app.notification_previews (requires EMAIL_DELIVERY_MODE=staging_outbox; default off).
# Only the lowercase literal `true` enables this flag (`TRUE`, `1`, etc. are treated as off).
STAGING_SIGNUP_LINK_ENABLED=
# Staging only: send password recovery via admin generateLink + token_hash callback URL into the outbox (requires EMAIL_DELIVERY_MODE=staging_outbox; default off).
APP_SENT_RECOVERY_ENABLED=
CRON_SECRET=

# Server-only Supabase service role (notification worker + payments promo RPCs).
SUPABASE_SECRET_KEY=

# Stripe sandbox (test mode only — reject pk_live_/sk_live_ in application code).
# Partial or missing keys return HTTP 503 payments_unavailable unless mock is explicitly enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYMENTS_MOCK_ENABLED=
# Never set STRIPE_MODE=live or STRIPE_LIVEMODE=1 in this POC.
# Mock checkout: PAYMENTS_MOCK_ENABLED=true exactly (non-production, or production only when APP_URL hostname
# and the request Host header both match STAGING_HOST_ALLOWLIST in src/lib/server/staging-host.ts).

# POC account switcher: server gate is POC_SWITCHER_ENABLED=true only (never use NEXT_PUBLIC_* as security).
# On production runtime (VERCEL_ENV=production or NODE_ENV=production without VERCEL_ENV), also requires APP_URL
# and request Host to both match the staging allowlist — same rules as mock payments on Vercel staging.
POC_SWITCHER_ENABLED=
# Server-only passwords for seeded personas (owner|buyer|dual @licitatiero.local).
POC_OWNER_PASSWORD=
POC_BUYER_PASSWORD=
POC_DUAL_PASSWORD=

# Catalogue map tiles (consent-gated). Default is OSMF standard raster URL (no {s} subdomains).
# Overrides must be https with host tile.openstreetmap.org (see MAP_TILE_HOST_ALLOWLIST in src/lib/map-tiles.ts).
NEXT_PUBLIC_MAP_TILE_URL=
# Optional HTML attribution string for the tile layer (default: © OpenStreetMap contributors).
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
# Server-only kill switch: osm (default, with dormant PMTiles failover) | pmtiles | off
MAP_TILE_PROVIDER=
# OSM tile load errors before activating the self-hosted extract (default 5 within 15s).
MAP_TILE_FAILOVER_ERRORS=
MAP_TILE_FAILOVER_WINDOW_MS=
