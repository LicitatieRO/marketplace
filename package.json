{
  "name": "licitatiero-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "local:env": "node scripts/local-env.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "security:scan": "node scripts/scan-secrets.mjs",
    "security:audit": "node scripts/audit-dependencies.mjs",
    "test:delivery": "node --test scripts/delivery.test.mjs",
    "test:concurrency": "node scripts/test-concurrency.mjs",
    "test:e2e:backend": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "local:stack": "node scripts/local-stack.mjs start",
    "test:http": "node --env-file=.env.local --test tests/integration/http.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "pmtiles": "^4.5.0",
    "protomaps-leaflet": "^5.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "pg": "^8.20.0",
    "supabase": "^2.75.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "type": "module"
}
